        <script><![CDATA[(function executeRule(current, previous) {
    if (current.u_stage == 'Approved' && previous.u_stage != 'Approved') {
        var proj = new GlideRecord('x_1805046_app_fo_0_ppm_project');
        proj.initialize();
        proj.setValue('u_number', 'PRJ-' + current.u_demand_id);
        proj.setValue('u_name', current.u_title);
        proj.setValue('u_project_manager', current.u_requester);
        proj.setValue('u_state', 'Planning');
        proj.setValue('u_priority', 'Moderate');
        proj.setValue('u_estimated_cost', current.u_roi_estimate);
        var projId = proj.insert();
        gs.info('[AppForge SPM Flow] Automatically converted Approved Demand ' + current.u_demand_id + ' to Project: ' + projId);
    }
})(current, previous);]]></script>
