                            </tbody>
                        </table>
                    </div>
                    <div class="card">
                        <h3 style="font-size: 1rem; margin-bottom: 12px;">Operational Status</h3>
                        <p style="font-size: 0.85rem; color: var(--af-text-muted); margin-bottom: 8px;">Platform Release: <strong>v0.15.0</strong></p>
                        <p style="font-size: 0.85rem; color: var(--af-text-muted); margin-bottom: 8px;">Target Instance: <strong>dev280961.service-now.com</strong></p>
