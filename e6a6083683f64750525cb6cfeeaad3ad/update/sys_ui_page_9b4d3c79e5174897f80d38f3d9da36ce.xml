        .badge { padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; display: inline-block; }
        .badge-success { background-color: rgba(34, 197, 94, 0.15); color: var(--af-success); }
        .badge-warning { background-color: rgba(245, 158, 11, 0.15); color: var(--af-warning); }
        .badge-danger { background-color: rgba(239, 68, 68, 0.15); color: var(--af-danger); }
        .btn { padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: none; transition: background 0.15s; }
        .btn-primary { background-color: var(--af-primary); color: #000; }
        .btn-primary:hover { background-color: var(--af-primary-hover); }
        .btn-secondary { background-color: var(--af-card); color: var(--af-text); border: 1px solid var(--af-border); }

        /* Stepper & Pipeline */
        .stepper { display: flex; justify-content: space-between; margin-bottom: 24px; position: relative; }
        .step { display: flex; flex-direction: column; align-items: center; gap: 6px; z-index: 1; }
        .step-circle { width: 32px; height: 32px; border-radius: 50%; background-color: var(--af-card); border: 2px solid var(--af-border); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; }
        .step.active .step-circle { border-color: var(--af-primary); color: var(--af-primary); background-color: rgba(56, 189, 248, 0.1); }
