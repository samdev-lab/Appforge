                            <tr><td>POL-SEC-002</td><td>No eval() or Dynamic Scripts</td><td>SECURITY</td><td><span class="badge badge-danger">CRITICAL</span></td><td>DENY</td><td><span class="badge badge-success">COMPLIANT</span></td></tr>
                            <tr><td>POL-SEC-003</td><td>No Direct SQL / DDL</td><td>DATA</td><td><span class="badge badge-danger">CRITICAL</span></td><td>DENY</td><td><span class="badge badge-success">COMPLIANT</span></td></tr>
                            <tr><td>POL-SEC-005</td><td>Public Write APIs Require Auth</td><td>INTEGRATION</td><td><span class="badge badge-warning">HIGH</span></td><td>DENY</td><td><span class="badge badge-success">COMPLIANT</span></td></tr>
                            <tr><td>POL-SEC-006</td><td>4-Eyes Production Deployment Gate</td><td>DEPLOYMENT</td><td><span class="badge badge-danger">CRITICAL</span></td><td>DENY</td><td><span class="badge badge-success">COMPLIANT</span></td></tr>
                            <tr><td>POL-SEC-015</td><td>No Destructive Auto-Remediation</td><td>OPERATIONAL</td><td><span class="badge badge-danger">CRITICAL</span></td><td>DENY</td><td><span class="badge badge-success">COMPLIANT</span></td></tr>
