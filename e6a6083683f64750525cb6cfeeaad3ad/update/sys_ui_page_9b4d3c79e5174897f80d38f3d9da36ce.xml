<script>
    function switchTab(tabId, el) {
        var sections = document.querySelectorAll('.content-area section');
        for (var i = 0; i != sections.length; i++) sections[i].classList.add('hidden');
        var navs = document.querySelectorAll('.nav-item');
        for (var j = 0; j != navs.length; j++) navs[j].classList.remove('active');
        var target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');
        if (el) {
            el.classList.add('active');
            document.getElementById('view-title').innerText = el.innerText;
        }
    }

    function filterCategory(el, cat) {
        var pills = document.querySelectorAll('.cat-pill');
        for (var i = 0; i != pills.length; i++) pills[i].classList.remove('active');
        el.classList.add('active');
        var cards = document.querySelectorAll('.template-item-card');
        for (var j = 0; j != cards.length; j++) {
            if (cat === 'All' || cards[j].getAttribute('data-category') === cat) {
                cards[j].style.display = 'flex';
            } else {
                cards[j].style.display = 'none';
            }
        }
    }

    function openDetailsModal(id) {
        if (id === 'bulk_catalog_automation') {
            document.getElementById('dt-name').innerText = 'Bulk Catalog Automation';
            document.getElementById('dt-meta').innerText = 'Catalog / Automation • v1.0.0 • AppForge';
            document.getElementById('dt-status').innerText = 'CERTIFIED & READY';
            document.getElementById('dt-desc').innerText = 'Create and manage hundreds of ServiceNow Catalog Items from a single Excel workbook with variables and fulfillment rules.';
        } else {
            document.getElementById('dt-name').innerText = id.replace('_', ' ').toUpperCase();
            document.getElementById('dt-meta').innerText = 'Accelerator • v1.0.0 • AppForge';
            document.getElementById('dt-status').innerText = 'COMING SOON';
            document.getElementById('dt-desc').innerText = 'Enterprise accelerator module for ServiceNow.';
        }
        document.getElementById('modal-template-details').style.display = 'flex';
    }

    function closeDetailsModal() {
        document.getElementById('modal-template-details').style.display = 'none';
    }

