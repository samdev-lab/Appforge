        .step-label { font-size: 0.75rem; color: var(--af-text-muted); font-weight: 500; }

        /* Modal */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: none; align-items: center; justify-content: center; z-index: 100; }
        .modal-box { background: var(--af-surface); border: 1px solid var(--af-border); border-radius: 8px; width: 500px; padding: 24px; }
        .hidden { display: none !important; }
    </style>
</head>
<body>

