<script>
    function switchTab(tabId, el) {
        var sections = document.querySelectorAll('.content-area section');
        for (var i = 0; i != sections.length; i++) sections[i].classList.add('hidden');
        var navs = document.querySelectorAll('.nav-item');
        for (var j = 0; j != navs.length; j++) navs[j].classList.remove('active');
        var target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');
        if (el) {
            el.classList.add('active');
            document.getElementById('view-title').innerText = el.innerText;
        }
    }

    function openModal() {
        document.getElementById('modal-4eyes').style.display = 'flex';
    }
    function closeModal() {
        document.getElementById('modal-4eyes').style.display = 'none';
    }

    function submitFourEyes() {
        var req = document.getElementById('input-requester').value.trim();
        var app = document.getElementById('input-approver').value.trim();

        if (!app) {
            alert('Please enter the username of the Security Approver.');
            return;
        }

        if (req.toLowerCase() === app.toLowerCase()) {
            alert('❌ SEPARATION OF DUTIES VIOLATION (POL-SEC-006):\n\nRequester ("' + req + '") cannot approve their own release!\n\nA distinct user with sec_approver role must approve.');
            return;
        }

        closeModal();

        // Advance stepper
        var s4 = document.getElementById('step-4eyes');
        s4.className = 'step passed';
        s4.querySelector('.step-circle').innerText = '✓';

        var s5 = document.getElementById('step-deploy');
        s5.className = 'step passed';
        s5.querySelector('.step-circle').innerText = '✓';

        var s6 = document.getElementById('step-verify');
        s6.className = 'step passed';
        s6.querySelector('.step-circle').innerText = '✓';

        var resDiv = document.getElementById('deployment-result');
        resDiv.style.display = 'block';
        resDiv.innerHTML = '<div style="padding: 12px; background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; border-radius: 6px; color: #22c55e; font-size: 0.85rem;">' +
            '<strong>✅ PRODUCTION DEPLOYMENT CERTIFIED &amp; COMPLETE</strong><br/>' +
            '• Requester: ' + req + '<br/>' +
            '• Approver: <strong>' + app + '</strong> (Four-Eyes Gate Passed)<br/>' +
            '• Status: <strong>PRODUCTION_DEPLOYED (Immutable)</strong>' +
            '</div>';

        document.getElementById('deployment-actions').style.display = 'none';
    }
</script>
