<script>
    function switchTab(tabId, el) {
        var sections = document.querySelectorAll('.content-area section');
        for (var i = 0; i != sections.length; i++) sections[i].classList.add('hidden');
        var navs = document.querySelectorAll('.nav-item');
        for (var j = 0; j != navs.length; j++) navs[j].classList.remove('active');
        var target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');
        if (el) {
            el.classList.add('active');
            document.getElementById('view-title').innerText = el.innerText;
        }
    }

    function addVariableRow() {
        var tbody = document.getElementById('cf-variables-tbody');
        var tr = document.createElement('tr');
        var idx = tbody.children.length + 1;
        tr.innerHTML = '<td><input type="text" class="input-control" value="custom_var_' + idx + '" /></td>' +
            '<td><input type="text" class="input-control" value="Custom Question ' + idx + '" /></td>' +
            '<td><select class="input-control"><option>Single Line Text</option><option>Multi Line Text</option><option>Select Box</option><option>Date</option><option>Yes/No</option><option>Reference</option></select></td>' +
            '<td><span class="badge badge-info">OPTIONAL</span></td>' +
            '<td><code>None</code></td>' +
            '<td><button class="btn btn-secondary" style="padding: 2px 8px; font-size: 0.75rem;" onclick="this.closest(\'tr\').remove()">Remove</button></td>';
        tbody.appendChild(tr);
    }

    function executeDryRun() {
        var name = document.getElementById('cf-item-name').value;
        alert('🔍 DRY RUN DIAGNOSTIC REPORT:\n\n' +
            '• Catalog Item: "' + name + '" -> READY TO CREATE\n' +
            '• Variables to Create: ' + document.getElementById('cf-variables-tbody').children.length + '\n' +
            '• Approvals to Bind: 2 (Manager + Security)\n' +
            '• Fulfillment Tasks: 2 (IAM Account + Hardware Logistics)\n' +
            '• Pre-Flight Validation: 0 Errors, 0 Warnings\n\n' +
            'Status: 100% GREEN (Safe to Publish)');
    }

    function createAndPublishCatalog() {
        var name = document.getElementById('cf-item-name').value;
        var cat = document.getElementById('cf-item-category').value;
        var varCount = document.getElementById('cf-variables-tbody').children.length;

        // Add to inventory table live
        var tbody = document.getElementById('cf-inventory-tbody');
        var tr = document.createElement('tr');
        tr.innerHTML = '<td><strong>' + name + '</strong></td>' +
            '<td>' + cat + '</td>' +
            '<td>1.0</td>' +
            '<td>' + varCount + ' Variables</td>' +
            '<td>RITM + Tasks + Approvals</td>' +
            '<td><span class="badge badge-success">PUBLISHED</span></td>' +
            '<td><button class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;" onclick="cloneCatalogItem(\'' + name + '\')">Clone</button></td>';
        tbody.prepend(tr);

        alert('🎉 CATALOG FACTORY AUTOMATION EXECUTED!\n\n' +
            '1. Created Catalog Item "' + name + '" in sc_cat_item.\n' +
            '2. Generated ' + varCount + ' Variables in item_option_new.\n' +
            '3. Configured 2-Tier Approval Flow.\n' +
            '4. Created 2 Fulfillment Tasks and RITM Mappings.\n' +
            '5. Published & Live in Service Catalog!');
    }

    function cloneCatalogItem(name) {
        document.getElementById('cf-item-name').value = name + ' (Clone)';
        alert('📋 Cloned "' + name + '". You can now modify variables and click Create & Publish.');
    }

    function openBulkImportModal() { document.getElementById('modal-bulk').style.display = 'flex'; }
    function closeBulkImportModal() { document.getElementById('modal-bulk').style.display = 'none'; }

    function executeBulkImport() {
        closeBulkImportModal();
        alert('🎉 BULK IMPORT COMPLETED!\n\n' +
            '• Processed: 3 Catalog Items\n' +
            '• Created: 3 Items, 12 Variables, 6 Tasks\n' +
            '• Status: 100% SUCCESS (Published to Service Catalog)');
