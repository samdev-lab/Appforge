            <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitFourEyes()">Authorize &amp; Deploy 🚀</button>
        </div>
    </div>
</div>

<script>
    function switchTab(tabId, el) {
        var sections = document.querySelectorAll('.content-area section');
        for (var i = 0; i != sections.length; i++) sections[i].classList.add('hidden');
        var navs = document.querySelectorAll('.nav-item');
        for (var j = 0; j != navs.length; j++) navs[j].classList.remove('active');
        var target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');
        if (el) {
            el.classList.add('active');
            document.getElementById('view-title').innerText = el.innerText;
        }
    }

    function approveDemand(demandId, title, estCost) {
        var stageEl = document.getElementById('stage-' + demandId.toLowerCase().replace(/[^a-z0-9]/g, '-'));
        if (stageEl) {
            stageEl.className = 'badge badge-success';
            stageEl.innerText = 'APPROVED & CONVERTED';
        }
        alert('🎉 SPM AUTOMATION EXECUTED!\n\n1. Demand ' + demandId + ' marked as APPROVED.\n2. Automatically created Project "PRJ-' + demandId + '" in table x_1805046_app_fo_0_ppm_project!\n3. Cost allocated: $' + estCost.toLocaleString());
    }

    function openModal() { document.getElementById('modal-4eyes').style.display = 'flex'; }
    function closeModal() { document.getElementById('modal-4eyes').style.display = 'none'; }

    function submitFourEyes() {
        var req = document.getElementById('input-requester').value.trim();
        var app = document.getElementById('input-approver').value.trim();
        if (!app) { alert('Please enter the Security Approver Username.'); return; }
        if (req.toLowerCase() === app.toLowerCase()) {
            alert('❌ SEPARATION OF DUTIES VIOLATION (POL-SEC-006):\n\nRequester ("' + req + '") cannot self-approve production release!\n\nEnter an independent approver username to approve.');
            return;
        }
        closeModal();
        var s4 = document.getElementById('step-4eyes'); s4.className = 'step passed'; s4.querySelector('.step-circle').innerText = '✓';
        var s5 = document.getElementById('step-deploy'); s5.className = 'step passed'; s5.querySelector('.step-circle').innerText = '✓';
        var s6 = document.getElementById('step-verify'); s6.className = 'step passed'; s6.querySelector('.step-circle').innerText = '✓';
        var resDiv = document.getElementById('deployment-result'); resDiv.style.display = 'block';
        resDiv.innerHTML = '<div style="padding: 14px 18px; background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; border-radius: 8px; color: #22c55e; font-size: 0.9rem;">' +
            '<strong>✅ SPM/PPM ENTERPRISE RELEASE CERTIFIED &amp; DEPLOYED</strong><br/>' +
            '• Release Requester: ' + req + '<br/>' +
            '• Security Approver: <strong>' + app + '</strong> (Four-Eyes Gate Passed)<br/>' +
            '• State: <strong>PRODUCTION_DEPLOYED (Immutable)</strong>' +
            '</div>';
        document.getElementById('deployment-actions').style.display = 'none';
    }
</script>
