        .stat-val { font-size: 2rem; font-weight: 700; color: var(--af-text); margin-top: 8px; }
        .stat-lbl { font-size: 0.85rem; color: var(--af-text-muted); text-transform: uppercase; letter-spacing: 0.5px; }

        /* Tables & Lists */
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--af-border); font-size: 0.85rem; }
        th { color: var(--af-text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; }
        tr:hover { background-color: rgba(255, 255, 255, 0.02); }
        
