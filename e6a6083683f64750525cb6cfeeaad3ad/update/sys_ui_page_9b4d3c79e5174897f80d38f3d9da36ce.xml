<script>
    var currentTemplateId = '';
    var currentTemplateName = '';

    function switchTab(tabId, el) {
        var sections = document.querySelectorAll('.content-area section');
        for (var i = 0; i != sections.length; i++) sections[i].classList.add('hidden');
        var navs = document.querySelectorAll('.nav-item');
        for (var j = 0; j != navs.length; j++) navs[j].classList.remove('active');
        var target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');
        if (el) {
            el.classList.add('active');
            document.getElementById('view-title').innerText = el.innerText;
        }
    }

    function filterCategory(el, category) {
        var pills = document.querySelectorAll('.cat-pill');
        for (var i = 0; i != pills.length; i++) pills[i].classList.remove('active');
        el.classList.add('active');

        var cards = document.querySelectorAll('.template-item-card');
        for (var j = 0; j != cards.length; j++) {
            var cardCat = cards[j].getAttribute('data-category');
            if (category === 'All' || cardCat === category) {
                cards[j].classList.remove('hidden');
            } else {
                cards[j].classList.add('hidden');
            }
        }
    }

    function filterCatalog() {
        var q = document.getElementById('catalog-search').value.toLowerCase();
        var cards = document.querySelectorAll('.template-item-card');
        for (var i = 0; i != cards.length; i++) {
            var name = cards[i].getAttribute('data-name').toLowerCase();
            var cat = cards[i].getAttribute('data-category').toLowerCase();
            if (name.indexOf(q) !== -1 || cat.indexOf(q) !== -1) {
                cards[i].classList.remove('hidden');
            } else {
                cards[i].classList.add('hidden');
            }
        }
    }

    function openTemplateDetail(id, name, cat, version, desc, modules, tables) {
        currentTemplateId = id;
        currentTemplateName = name;
        document.getElementById('modal-detail-title').innerText = name;
        document.getElementById('modal-detail-cat').innerText = cat + ' • v' + version;
        document.getElementById('modal-detail-version').innerText = 'v' + version;
        document.getElementById('modal-detail-desc').innerText = desc;
        
        var modHtml = '';
        for (var i = 0; i != modules.length; i++) {
            modHtml += '• ' + modules[i] + '<br/>';
        }
        document.getElementById('modal-detail-modules').innerHTML = modHtml;

        document.getElementById('modal-detail-install-btn').onclick = function() {
            closeTemplateDetail();
            startInstallWizard(id, name, version, tables.length, 12);
        };

        document.getElementById('modal-template-detail').style.display = 'flex';
    }

    function closeTemplateDetail() {
        document.getElementById('modal-template-detail').style.display = 'none';
    }

    function startInstallWizard(id, name, version, tableCount, fieldCount) {
        currentTemplateId = id;
        currentTemplateName = name;
        document.getElementById('wiz-app-title').innerText = name;
        document.getElementById('wiz-input-name').value = name;
        document.getElementById('wizard-screen-config').classList.remove('hidden');
        document.getElementById('wizard-screen-progress').classList.add('hidden');
        document.getElementById('modal-wizard').style.display = 'flex';
    }

    function closeWizard() {
        document.getElementById('modal-wizard').style.display = 'none';
    }

    function proceedToInstallExecution() {
        document.getElementById('wizard-screen-config').classList.add('hidden');
        document.getElementById('wizard-screen-progress').classList.remove('hidden');
        document.getElementById('wiz-progress-title').innerText = '🎉 Installation Completed Successfully!';
        document.getElementById('wiz-complete-actions').classList.remove('hidden');

        // Add to Installed Applications table
        var tbody = document.getElementById('installed-apps-tbody');
        var tr = document.createElement('tr');
        tr.innerHTML = '<td><strong>' + document.getElementById('wiz-input-name').value + '</strong></td>' +
            '<td>v1.0.0</td>' +
            '<td><span class="badge badge-info">Production</span></td>' +
            '<td><span class="badge badge-success">● HEALTHY</span></td>' +
            '<td>Just now</td>' +
