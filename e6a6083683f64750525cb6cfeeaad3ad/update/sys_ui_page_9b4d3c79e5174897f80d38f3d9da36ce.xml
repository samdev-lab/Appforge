    <!-- Four-Eyes Modal -->
    <div id="modal-approval" class="modal-overlay">
        <div class="modal-box">
            <h3 style="margin-bottom: 12px;">Four-Eyes Deployment Approval</h3>
            <p style="font-size: 0.85rem; color: var(--af-text-muted); margin-bottom: 16px;">Separation of Duties Rule: Approver must be distinct from Requester (dev_lead).</p>
            <div style="margin-bottom: 16px;">
                <label style="font-size: 0.8rem; color: var(--af-text-muted); display: block; margin-bottom: 4px;">Approver User ID:</label>
                <input type="text" id="approver-id" value="sec_approver" style="width: 100%; padding: 8px; background: var(--af-card); border: 1px solid var(--af-border); color: var(--af-text); border-radius: 4px;">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="btn btn-secondary" onclick="closeApprovalModal()">Cancel</button>
                <button class="btn btn-primary" onclick="submitApproval()">Approve & Deploy</button>
            </div>
        </div>
