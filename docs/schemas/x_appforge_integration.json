{
  "name": "x_appforge_integration",
  "label": "AppForge Master Integration Registry",
  "description": "Master registry storing all integration configurations (Inbound, Outbound, Webhooks)",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "integration_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "module", "type": "Reference", "reference_table": "x_appforge_module", "indexed": true },
    { "name": "type", "type": "Choice", "choices": ["REST", "WEBHOOK", "SCRIPTED_REST", "OUTBOUND_REST"], "mandatory": true },
    { "name": "direction", "type": "Choice", "choices": ["INBOUND", "OUTBOUND", "BIDIRECTIONAL"], "mandatory": true },
    { "name": "provider", "type": "String", "max_length": 100 },
    { "name": "base_url", "type": "String", "max_length": 500 },
    { "name": "authentication_reference", "type": "String", "max_length": 100, "description": "Reference name for credential connection, never raw secret" },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" },
    { "name": "status", "type": "Choice", "choices": ["ACTIVE", "INACTIVE", "DEPRECATED"], "default_value": "ACTIVE" },
    { "name": "owner", "type": "String", "max_length": 100 },
    { "name": "description", "type": "String", "max_length": 1000 },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow platform integration sys_id" }
  ],
  "indexes": [
    { "name": "idx_integration_id", "fields": ["integration_id"], "unique": true },
    { "name": "idx_integration_app", "fields": ["application", "name"] }
  ]
}
