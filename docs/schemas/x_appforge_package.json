{
  "name": "x_appforge_package",
  "label": "AppForge Application Package Registry",
  "description": "Master registry storing versioned, portable application package manifests, checksums, and signatures",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "package_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "version", "type": "String", "max_length": 30, "mandatory": true, "indexed": true },
    { "name": "package_type", "type": "Choice", "choices": ["FULL", "PATCH", "UPGRADE", "HOTFIX"], "default_value": "FULL" },
    { "name": "manifest_json", "type": "String", "max_length": 32000, "description": "Complete declarative package manifest" },
    { "name": "checksum", "type": "String", "max_length": 64, "mandatory": true, "description": "Deterministic SHA-256 canonical checksum" },
    { "name": "status", "type": "Choice", "choices": ["DRAFT", "PUBLISHED", "STAGED", "ARCHIVED"], "default_value": "DRAFT" },
    { "name": "source_branch", "type": "String", "max_length": 200 },
    { "name": "source_commit", "type": "String", "max_length": 100 },
    { "name": "signed", "type": "Boolean", "default_value": false },
    { "name": "signature", "type": "String", "max_length": 500 },
    { "name": "description", "type": "String", "max_length": 1000 },
    { "name": "created_by", "type": "String", "max_length": 100 },
    { "name": "created_at", "type": "GlideDateTime" }
  ],
  "indexes": [
    { "name": "idx_pkg_id", "fields": ["package_id"], "unique": true },
    { "name": "idx_pkg_app_ver", "fields": ["application", "version"], "unique": true }
  ]
}
