{
  "name": "x_appforge_authentication",
  "label": "AppForge Authentication Configuration",
  "description": "Registry storing authentication configuration metadata using secure credential references (no raw secrets)",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "auth_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "type", "type": "Choice", "choices": ["NONE", "BASIC", "API_KEY", "OAUTH2", "BEARER_TOKEN"], "mandatory": true },
    { "name": "credential_reference", "type": "String", "max_length": 100, "mandatory": true, "description": "Reference identifier to ServiceNow secure credential/connection, never raw secret" },
    { "name": "header_name", "type": "String", "max_length": 100, "default_value": "Authorization" },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "status", "type": "Choice", "choices": ["ACTIVE", "INACTIVE"], "default_value": "ACTIVE" }
  ],
  "indexes": [
    { "name": "idx_auth_id", "fields": ["auth_id"], "unique": true }
  ]
}
