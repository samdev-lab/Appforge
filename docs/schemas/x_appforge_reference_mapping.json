{
  "name": "x_appforge_reference_mapping",
  "label": "AppForge Reference Mapping Registry",
  "description": "Registry tracking source-to-target foreign key and reference value mappings during migration",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "mapping_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "migration", "type": "Reference", "reference_table": "x_appforge_migration", "mandatory": true, "indexed": true },
    { "name": "source_table", "type": "String", "max_length": 100, "mandatory": true },
    { "name": "source_value", "type": "String", "max_length": 255, "mandatory": true },
    { "name": "target_value", "type": "String", "max_length": 255, "mandatory": true },
    { "name": "status", "type": "Choice", "choices": ["MAPPED", "UNMAPPED", "ORPHANED", "RESOLVED"], "default_value": "MAPPED" }
  ],
  "indexes": [
    { "name": "idx_ref_map_id", "fields": ["mapping_id"], "unique": true }
  ]
}
