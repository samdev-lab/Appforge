{
  "name": "x_appforge_acl",
  "label": "AppForge ACL Registry",
  "description": "Registry storing Access Control List (ACL) definitions for tables, records, and fields",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "acl_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "type", "type": "Choice", "choices": ["record", "field", "rest_endpoint", "ui_page"], "default_value": "record" },
    { "name": "table_name", "type": "String", "max_length": 100, "mandatory": true, "indexed": true },
    { "name": "field_name", "type": "String", "max_length": 100, "description": "* for table-level, or specific column name" },
    { "name": "operation", "type": "Choice", "choices": ["create", "read", "write", "delete", "execute"], "mandatory": true },
    { "name": "roles_json", "type": "String", "max_length": 4000, "description": "JSON array of required role names" },
    { "name": "condition_json", "type": "String", "max_length": 4000, "description": "Declarative record-level condition JSON" },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow sys_security_acl sys_id" }
  ],
  "indexes": [
    { "name": "idx_acl_id", "fields": ["acl_id"], "unique": true },
    { "name": "idx_acl_table_op", "fields": ["table_name", "operation"] }
  ]
}
