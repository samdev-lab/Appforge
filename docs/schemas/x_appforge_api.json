{
  "name": "x_appforge_api",
  "label": "AppForge Scripted REST API Registry",
  "description": "Registry storing Inbound Scripted REST API definitions mapped to sys_ws_definition",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "api_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "v1" },
    { "name": "base_path", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "authentication_type", "type": "Choice", "choices": ["NONE", "BASIC", "API_KEY", "OAUTH2", "BEARER_TOKEN"], "default_value": "BASIC" },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "description", "type": "String", "max_length": 1000 },
    { "name": "status", "type": "Choice", "choices": ["ACTIVE", "INACTIVE", "DEPRECATED"], "default_value": "ACTIVE" },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow sys_ws_definition sys_id" }
  ],
  "indexes": [
    { "name": "idx_api_id", "fields": ["api_id"], "unique": true },
    { "name": "idx_api_base_path", "fields": ["base_path", "version"], "unique": true }
  ]
}
