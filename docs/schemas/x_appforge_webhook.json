{
  "name": "x_appforge_webhook",
  "label": "AppForge Inbound Webhook Registry",
  "description": "Registry storing Inbound Webhook configurations with HMAC signature validation and replay defense",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "webhook_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "endpoint_path", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "target_event", "type": "String", "max_length": 100 },
    { "name": "signature_method", "type": "Choice", "choices": ["HMAC-SHA256", "HMAC-SHA1", "NONE"], "default_value": "HMAC-SHA256" },
    { "name": "secret_reference", "type": "String", "max_length": 100, "description": "Property or credential reference name storing webhook secret, never raw secret" },
    { "name": "replay_protection", "type": "Boolean", "default_value": true },
    { "name": "rate_limit_per_minute", "type": "Integer", "default_value": 60 },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" }
  ],
  "indexes": [
    { "name": "idx_webhook_id", "fields": ["webhook_id"], "unique": true }
  ]
}
