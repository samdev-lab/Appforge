{
  "name": "x_appforge_data_policy",
  "label": "AppForge Data Policy Registry",
  "description": "Registry storing platform Data Policies and field rule enforcement definitions",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "data_policy_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "table_name", "type": "String", "max_length": 100, "mandatory": true, "indexed": true },
    { "name": "field_name", "type": "String", "max_length": 100, "mandatory": true },
    { "name": "mandatory", "type": "Choice", "choices": ["ignore", "true", "false"], "default_value": "ignore" },
    { "name": "read_only", "type": "Choice", "choices": ["ignore", "true", "false"], "default_value": "ignore" },
    { "name": "apply_to_imports", "type": "Boolean", "default_value": true },
    { "name": "apply_to_soap_rest", "type": "Boolean", "default_value": true },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow sys_data_policy2 sys_id" }
  ],
  "indexes": [
    { "name": "idx_dp_id", "fields": ["data_policy_id"], "unique": true }
  ]
}
