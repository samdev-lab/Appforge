{
  "name": "x_appforge_intelligence_recommendation",
  "label": "AppForge Intelligence Recommendation Log",
  "description": "Log of deterministic recommendations generated by diagnostic analysis",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "recommendation_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "intelligence_run", "type": "Reference", "reference_table": "x_appforge_intelligence_run", "mandatory": true, "indexed": true },
    { "name": "priority", "type": "Choice", "choices": ["LOW", "MEDIUM", "HIGH", "CRITICAL"], "default_value": "MEDIUM" },
    { "name": "reason", "type": "String", "max_length": 2000, "mandatory": true },
    { "name": "affected_component", "type": "String", "max_length": 100 },
    { "name": "action_type", "type": "String", "max_length": 100 },
    { "name": "safe_to_automate", "type": "Boolean", "default_value": false },
    { "name": "safety_classification", "type": "Choice", "choices": ["READ_ONLY", "SAFE_AUTOMATION", "APPROVAL_REQUIRED", "FORBIDDEN"], "default_value": "APPROVAL_REQUIRED" },
    { "name": "created_on", "type": "GlideDateTime" }
  ],
  "indexes": [
    { "name": "idx_rec_id", "fields": ["recommendation_id"], "unique": true }
  ]
}
