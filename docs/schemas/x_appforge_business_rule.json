{
  "name": "x_appforge_business_rule",
  "label": "AppForge Business Rule Registry",
  "description": "Registry tracking declarative Business Rules provisioned by AppForge",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "business_rule_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "logic_registry", "type": "Reference", "reference_table": "x_appforge_logic", "indexed": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "table_name", "type": "String", "max_length": 100, "mandatory": true },
    { "name": "when", "type": "Choice", "choices": ["BEFORE", "AFTER", "ASYNC", "DISPLAY"], "mandatory": true },
    { "name": "order", "type": "Integer", "default_value": 100 },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "condition_json", "type": "String", "max_length": 4000, "description": "Declarative condition definition JSON" },
    { "name": "actions_json", "type": "String", "max_length": 8000, "description": "Declarative actions definition JSON" },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" },
    { "name": "status", "type": "Choice", "choices": ["DRAFT", "ACTIVE", "INACTIVE", "DEPRECATED"], "default_value": "ACTIVE" },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow sys_script (Business Rule) sys_id" },
    { "name": "previous_version_json", "type": "String", "max_length": 8000, "description": "Previous version snapshot for audit trail" }
  ],
  "indexes": [
    { "name": "idx_br_id", "fields": ["business_rule_id"], "unique": true },
    { "name": "idx_br_app_table", "fields": ["application", "table_name"] }
  ]
}
