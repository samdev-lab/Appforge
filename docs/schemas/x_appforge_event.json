{
  "name": "x_appforge_event",
  "label": "AppForge Event Registry",
  "description": "Registry tracking application Event definitions registered by AppForge",
  "scope": "x_appforge",
  "fields": [
    { "name": "sys_id", "type": "GUID", "mandatory": true, "primary_key": true },
    { "name": "event_id", "type": "String", "max_length": 100, "mandatory": true, "unique": true, "indexed": true },
    { "name": "logic_registry", "type": "Reference", "reference_table": "x_appforge_logic", "indexed": true },
    { "name": "application", "type": "Reference", "reference_table": "x_appforge_application", "mandatory": true, "indexed": true },
    { "name": "name", "type": "String", "max_length": 200, "mandatory": true },
    { "name": "table_name", "type": "String", "max_length": 100 },
    { "name": "description", "type": "String", "max_length": 1000 },
    { "name": "queue", "type": "Choice", "choices": ["DEFAULT", "FAST", "SLOW"], "default_value": "DEFAULT" },
    { "name": "active", "type": "Boolean", "default_value": true },
    { "name": "payload_definition_json", "type": "String", "max_length": 4000, "description": "Controlled event payload field mapping definition" },
    { "name": "version", "type": "String", "max_length": 20, "default_value": "1.0.0" },
    { "name": "sn_sys_id", "type": "String", "max_length": 32, "description": "ServiceNow sysevent_register sys_id" }
  ],
  "indexes": [
    { "name": "idx_event_id", "fields": ["event_id"], "unique": true },
    { "name": "idx_event_name_app", "fields": ["name", "application"], "unique": true }
  ]
}
